# =============================================================================
# Environment Variables — Agentic Log Analysis System
#
# Copy this file to .env and fill in your values before running the stack.
# NEVER commit .env — it is gitignored. Only commit .env.example.
# API keys and secrets must live in .env, never in source code.
# =============================================================================

# PostgreSQL — accessed only by shared-data-api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=insurance

# MongoDB — accessed only by shared-data-api
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=mongo
MONGO_INITDB_DATABASE=insurance

# Shared Data API — owns both databases (see docs/tech/data-model.md)
SHARED_DATA_API_POSTGRES_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/insurance
SHARED_DATA_API_MONGODB_URI=mongodb://mongo:mongo@mongodb:27017/insurance?authSource=admin

# SDA base URL — used by FNOL / CP / AP to reach the Shared Data API
# (compose service name + internal port; not the host-exposed 8002 port).
SHARED_DATA_API_BASE_URL=http://shared-data-api:8000

# Chaos middleware — header-driven failure simulation across all 4 monitored
# apps (SDA / FNOL / CP / AP). Default off; flip to "true" when running the
# Agitator's chaos-cascade scenarios (PR 3). See ADR-013.
# When enabled, send `X-Chaos: slow:<ms>` (0..60000) or `X-Chaos: error:<status>`
# (400..599) on any request to induce the simulated failure.
ENABLE_CHAOS=false

# JWT (issued by shared-data-api, verified by fnol-app / customer-portal / agent-portal)
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Per-app API keys (X-API-Key header for inter-service auth to shared-data-api)
SHARED_DATA_API_KEY_FNOL=fnol_app_api_key_change_me
SHARED_DATA_API_KEY_CUSTOMER_PORTAL=customer_portal_api_key_change_me
SHARED_DATA_API_KEY_AGENT_PORTAL=agent_portal_api_key_change_me

# Dashboard standalone auth — intentionally independent of the Shared Data API so the
# dashboard remains operational when the insurance apps are sick. See ADR-006.
DASHBOARD_JWT_SECRET=change_me_to_a_different_long_random_string
DASHBOARD_ADMIN_USERNAME=Admin
DASHBOARD_ADMIN_PASSWORD=Admin

# Demo logins (seeded by shared-data-api on startup) — for manual testing only.
# Customer passwords are all "customer"; agent passwords are all "agent".
DEMO_CUSTOMER_USERNAMES=alice,bob,carol,dave,eve
DEMO_AGENT_USERNAMES=agent1,agent2,agent3,agent4,agent5

# Agentic Log Analysis Dashboard (Phase 7)
# Note: dashboard vars use DASHBOARD_* short prefix by convention (not the full app name).
OPENAI_API_KEY=your_openai_api_key_here
# Embedding model used by the Phase 7d Chroma ingestion pipeline.
# IMPORTANT: changing this AFTER Chroma has been populated requires wiping the
# collection (`docker compose down && docker volume rm agentic-log-analysis-system_chroma-data`).
# Vectors from different models are NOT comparable (3-small=1536 dims, 3-large=3072).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Chat model used by the Phase 7e LangGraph agent (defined now for visibility; unused until 7e ships).
OPENAI_CHAT_MODEL=gpt-4o
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=agentic-log-analysis
DASHBOARD_CHROMA_URL=http://chroma:8000
# Ingest gate — controls what gets embedded into Chroma (the operator-facing
# /api/logs view is unaffected; it reads volumes directly).
# Defaults send ONLY PROD WARN/ERROR — tightest signal, minimal cost.
DASHBOARD_INGEST_LEVELS=WARN,ERROR
DASHBOARD_INGEST_SOURCES=prod
# Dry-run: parse + filter as normal but DO NOT call OpenAI or write to Chroma.
# Use this when validating filter behavior against a live log stream without
# paying for embeddings. Set back to false to actually populate the store.
DASHBOARD_INGEST_DRY_RUN=false

# Frontend API base URLs — local Vite dev server only (Phases 4–7)
# In Docker, React is served from the same container as the backend — use relative paths there.
# These are only needed when running `pnpm dev` outside of Docker during frontend development.
VITE_FNOL_API_BASE_URL=http://localhost:8001
VITE_CUSTOMER_PORTAL_API_BASE_URL=http://localhost:3001
VITE_AGENT_PORTAL_API_BASE_URL=http://localhost:8081
VITE_DASHBOARD_API_BASE_URL=http://localhost:4001
